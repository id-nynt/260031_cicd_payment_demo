{
  "name": "payment-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:traffic": "node --test scripts/tests/traffic-scenario.test.mjs",
    "test:watch": "vitest",
    "traffic:demo": "node scripts/generate-demo-traffic.mjs",
    "traffic:experiment": "node scripts/generate-experiment-traffic.mjs",
    "telemetry:show": "node scripts/show-telemetry.mjs",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:generate": "echo \"Create SQL migrations in src/db/migrations\""
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "fastify": "^5.2.1",
    "fastify-raw-body": "^5.0.0",
    "pg": "^8.13.1",
    "stripe": "^17.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
